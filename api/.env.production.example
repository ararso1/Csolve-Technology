# Copy to .env on the cPanel server for https://api.csolvetechnology.com/
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.csolvetechnology.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.csolvetechnology.com,https://csolvetechnology.com,https://www.csolvetechnology.com
DJANGO_SECURE_SSL_REDIRECT=False
CORS_ALLOWED_ORIGINS=https://csolvetechnology.com,https://www.csolvetechnology.com
