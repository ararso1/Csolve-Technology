# Copy to .env on the server and fill in cPanel MySQL values.
# Never commit the real .env file.

WP_ENV=production

# cPanel → MySQL® Databases (create DB + user, then grant ALL privileges)
DB_NAME=your_cpanel_db_name
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_strong_db_password
DB_HOST=localhost

# Live site URLs (no trailing slash)
WP_HOME=https://csolvetechnology.com
WP_SITEURL=https://csolvetechnology.com

TABLE_PREFIX=qppq8_

WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
